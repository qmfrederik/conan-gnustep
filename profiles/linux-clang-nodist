[settings]
arch=x86_64
build_type=Release
compiler=gcc
compiler.version=13
compiler.cppstd=20
compiler.libcxx=libstdc++11
os=Linux

{% for ref in [
    "libobjc2/*",
    "libdispatch/*",
    "gnustep-*/*",
    {# Include test_package contexts (consumers) #}
    "&"
] %}
{{ ref }}:compiler=clang
{{ ref }}:compiler.version=22
{% endfor %}

os=Linux

[conf]

{% for ref in [
    "libobjc2/*",
    "libdispatch/*",
    "gnustep-*/*",
    {# Include test_package contexts (consumers) #}
    "&"
] %}
{{ ref }}:tools.build:compiler_executables={"c": "/usr/bin/clang", "cpp": "/usr/bin/clang++"}
{% endfor %}
