{# All gnustep packages are built with clang; "&" is the a "consumer" package (the package being built), which also covers test_package contexts (consumers). #}
{% set gnustep_refs = ["libobjc2/*", "libdispatch/*", "gnustep-*/*", "&"] %}
{% set clang_version=22 %}

[settings]
arch=x86_64
build_type=Release
compiler=gcc
compiler.version=13
compiler.cppstd=20
compiler.libcxx=libstdc++11
os=Linux

{% for ref in gnustep_refs %}
{{ ref }}:compiler=clang
{{ ref }}:compiler.version={{ clang_version }}
{% endfor %}

os=Linux

[conf]

{% for ref in gnustep_refs %}
{{ ref }}:tools.build:compiler_executables={"c": "/usr/bin/clang-{{ clang_version }}", "cpp": "/usr/bin/clang++-{{ clang_version }}"}
{% endfor %}
