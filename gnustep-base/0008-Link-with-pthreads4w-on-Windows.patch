diff --git a/configure b/configure
index d75b02e..83b6775 100644
--- a/configure
+++ b/configure
@@ -7296,9 +7296,11 @@ else
 fi
 
 ismingw=no
+iswindows=no
 checkinlibc=no
 case "$target_os" in
   mingw*)	ismingw=yes;;
+  windows*)	iswindows=yes;;
   nto*)		checkinlibc=yes;;
   qnx*)		checkinlibc=yes;;
   *android*)   checkinlibc=yes;;
@@ -7353,6 +7355,53 @@ fi
       LIBS="$LIBS -lpthreadGC2"
     fi
   fi
+  if test $iswindows = yes ; then
+    { $as_echo "$as_me:${as_lineno-$LINENO}: checking for pthread_join in -lpthreadVC3" >&5
+$as_echo_n "checking for pthread_join in -lpthreadVC3... " >&6; }
+if ${ac_cv_lib_pthreadVC3_pthread_join+:} false; then :
+  $as_echo_n "(cached) " >&6
+else
+  ac_check_lib_save_LIBS=$LIBS
+LIBS="-lpthreadVC3  $LIBS"
+cat confdefs.h - <<_ACEOF >conftest.$ac_ext
+/* end confdefs.h.  */
+
+/* Override any GCC internal prototype to avoid an error.
+   Use char because int might match the return type of a GCC
+   builtin and then its argument prototype would still apply.  */
+#ifdef __cplusplus
+extern "C"
+#endif
+char pthread_join ();
+int
+main ()
+{
+return pthread_join ();
+  ;
+  return 0;
+}
+_ACEOF
+if ac_fn_c_try_link "$LINENO"; then :
+  ac_cv_lib_pthreadVC3_pthread_join=yes
+else
+  ac_cv_lib_pthreadVC3_pthread_join=no
+fi
+rm -f core conftest.err conftest.$ac_objext \
+    conftest$ac_exeext conftest.$ac_ext
+LIBS=$ac_check_lib_save_LIBS
+fi
+{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $ac_cv_lib_pthreadVC3_pthread_join" >&5
+$as_echo "$ac_cv_lib_pthreadVC3_pthread_join" >&6; }
+if test "x$ac_cv_lib_pthreadVC3_pthread_join" = xyes; then :
+  pthread_ok=yes
+else
+  pthread_ok=no
+fi
+
+    if test $pthread_ok = yes ; then
+      LIBS="$LIBS -lpthreadVC3"
+    fi
+  fi
   # Android and QNX have pthread in libc instead of libpthread
   if test $checkinlibc = yes ; then
     { $as_echo "$as_me:${as_lineno-$LINENO}: checking for pthread_join in -lc" >&5
diff --git a/configure.ac b/configure.ac
index be661ff..2ef4de7 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1718,9 +1718,11 @@ else
 fi
 AC_CHECK_LIB(pthread, pthread_join, pthread_ok=yes, pthread_ok=no)
 ismingw=no
+iswindows=no
 checkinlibc=no
 case "$target_os" in
   mingw*)	ismingw=yes;;
+  windows*)	iswindows=yes;;
   nto*)		checkinlibc=yes;;
   qnx*)		checkinlibc=yes;;
   *android*)   checkinlibc=yes;;
@@ -1734,6 +1736,13 @@ else
       LIBS="$LIBS -lpthreadGC2"
     fi
   fi
+  # pthreads4w names its import library pthreadVC3
+  if test $iswindows = yes ; then
+    AC_CHECK_LIB(pthreadVC3, pthread_join, pthread_ok=yes, pthread_ok=no)
+    if test $pthread_ok = yes ; then
+      LIBS="$LIBS -lpthreadVC3"
+    fi
+  fi
   # Android and QNX have pthread in libc instead of libpthread
   if test $checkinlibc = yes ; then
     AC_CHECK_LIB(c, pthread_join, pthread_ok=yes, pthread_ok=no)
