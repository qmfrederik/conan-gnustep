From ce1cbf79f1b2aaff001791e24584d4f4098b3bcc Mon Sep 17 00:00:00 2001
From: Frederik Carlier <frederik.carlier@keysight.com>
Date: Sun, 11 Oct 2026 15:02:09 +0200
Subject: [PATCH] Support libtiff-4 as pkg-config name for tiff

Various distributions appears to be using `libtiff-4` as the `pkg-config` name of the tiff package, e.g. https://packages.ubuntu.com/search?searchon=contents&keywords=libtiff-4.pc&mode=exactfilename&suite=resolute&arch=any
---
 configure    | 83 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 configure.ac | 17 +++++++++++
 2 files changed, 100 insertions(+)

diff --git a/configure b/configure
index b01f8d04e2..2a32c22aa7 100755
--- a/configure
+++ b/configure
@@ -5039,6 +5039,88 @@ if test -n "$with_tiff_include"; then
   with_tiff_include="-I$with_tiff_include"
 fi
 
+have_tiff=no
+# Prefer pkg-config unless the paths were given explicitly.
+if test -z "$with_tiff_library" && test -z "$with_tiff_include"; then
+
+pkg_failed=no
+{ $as_echo "$as_me:${as_lineno-$LINENO}: checking for libtiff-4" >&5
+$as_echo_n "checking for libtiff-4... " >&6; }
+
+if test -n "$TIFF_CFLAGS"; then
+    pkg_cv_TIFF_CFLAGS="$TIFF_CFLAGS"
+ elif test -n "$PKG_CONFIG"; then
+    if test -n "$PKG_CONFIG" && \
+    { { $as_echo "$as_me:${as_lineno-$LINENO}: \$PKG_CONFIG --exists --print-errors \"libtiff-4\""; } >&5
+  ($PKG_CONFIG --exists --print-errors "libtiff-4") 2>&5
+  ac_status=$?
+  $as_echo "$as_me:${as_lineno-$LINENO}: \$? = $ac_status" >&5
+  test $ac_status = 0; }; then
+  pkg_cv_TIFF_CFLAGS=`$PKG_CONFIG --cflags "libtiff-4" 2>/dev/null`
+		      test "x$?" != "x0" && pkg_failed=yes
+else
+  pkg_failed=yes
+fi
+ else
+    pkg_failed=untried
+fi
+if test -n "$TIFF_LIBS"; then
+    pkg_cv_TIFF_LIBS="$TIFF_LIBS"
+ elif test -n "$PKG_CONFIG"; then
+    if test -n "$PKG_CONFIG" && \
+    { { $as_echo "$as_me:${as_lineno-$LINENO}: \$PKG_CONFIG --exists --print-errors \"libtiff-4\""; } >&5
+  ($PKG_CONFIG --exists --print-errors "libtiff-4") 2>&5
+  ac_status=$?
+  $as_echo "$as_me:${as_lineno-$LINENO}: \$? = $ac_status" >&5
+  test $ac_status = 0; }; then
+  pkg_cv_TIFF_LIBS=`$PKG_CONFIG --libs "libtiff-4" 2>/dev/null`
+		      test "x$?" != "x0" && pkg_failed=yes
+else
+  pkg_failed=yes
+fi
+ else
+    pkg_failed=untried
+fi
+
+
+
+if test $pkg_failed = yes; then
+        { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
+$as_echo "no" >&6; }
+
+if $PKG_CONFIG --atleast-pkgconfig-version 0.20; then
+        _pkg_short_errors_supported=yes
+else
+        _pkg_short_errors_supported=no
+fi
+        if test $_pkg_short_errors_supported = yes; then
+	        TIFF_PKG_ERRORS=`$PKG_CONFIG --short-errors --print-errors --cflags --libs "libtiff-4" 2>&1`
+        else
+	        TIFF_PKG_ERRORS=`$PKG_CONFIG --print-errors --cflags --libs "libtiff-4" 2>&1`
+        fi
+	# Put the nasty error message in config.log where it belongs
+	echo "$TIFF_PKG_ERRORS" >&5
+
+	:
+elif test $pkg_failed = untried; then
+        { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
+$as_echo "no" >&6; }
+	:
+else
+	TIFF_CFLAGS=$pkg_cv_TIFF_CFLAGS
+	TIFF_LIBS=$pkg_cv_TIFF_LIBS
+        { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
+$as_echo "yes" >&6; }
+
+      have_tiff=yes
+      GRAPHIC_LFLAGS="$TIFF_LIBS $GRAPHIC_LFLAGS"
+      GRAPHIC_CFLAGS="$TIFF_CFLAGS $GRAPHIC_CFLAGS"
+      CPPFLAGS="$TIFF_CFLAGS ${CPPFLAGS}"
+
+fi
+fi
+
+if test "$have_tiff" != yes; then
 CPPFLAGS="$with_tiff_include ${CPPFLAGS}"
 LDFLAGS="$with_tiff_library ${LDFLAGS}"
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking for main in -lz" >&5
@@ -5228,6 +5310,7 @@ printf "%s\n" "yes" >&6; }
 fi
   fi
 fi
+fi
 
 if test "$have_tiff" = no; then
   { printf "%s\n" "$as_me:${as_lineno-$LINENO}: WARNING: Cannot find libtiff header and/or library" >&5
diff --git a/configure.ac b/configure.ac
index b9f457555d..c3f4e48017 100644
--- a/configure.ac
+++ b/configure.ac
@@ -281,6 +281,22 @@ if test -n "$with_tiff_include"; then
   with_tiff_include="-I$with_tiff_include"
 fi
 
+have_tiff=no
+# Prefer pkg-config unless the paths were given explicitly.
+if test -z "$with_tiff_library" && test -z "$with_tiff_include"; then
+  PKG_CHECK_MODULES(
+    [TIFF],
+    [libtiff-4],
+    [
+      have_tiff=yes
+      GRAPHIC_LFLAGS="$TIFF_LIBS $GRAPHIC_LFLAGS"
+      GRAPHIC_CFLAGS="$TIFF_CFLAGS $GRAPHIC_CFLAGS"
+      CPPFLAGS="$TIFF_CFLAGS ${CPPFLAGS}"
+    ],
+    [:])
+fi
+
+if test "$have_tiff" != yes; then
 CPPFLAGS="$with_tiff_include ${CPPFLAGS}"
 LDFLAGS="$with_tiff_library ${LDFLAGS}"
 AC_CHECK_LIB(z, main)
@@ -303,6 +319,7 @@ if test "$have_tiff" = yes; then
       ])
   fi
 fi
+fi
 
 if test "$have_tiff" = no; then
   AC_MSG_WARN(Cannot find libtiff header and/or library)
